// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 學生基本資料 (學號、真實姓名、基礎性別 BOY/GIRL)
model Student {
  id              String                  @id @default(cuid())
  studentNumber   String                  @unique // 例如 S101
  name            String
  gender          String                  @default("BOY") // 'BOY' | 'GIRL' (決定 Sprite 基礎性別)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  examScores      ExamScore[]
  homeworkRecords HomeworkRecord[]
  questLogs       StudentWeeklyQuestLog[]
  weeklyLoadouts  WeeklyStudentLoadout[]
  matchesAsP1     BattleMatch[]           @relation("PlayerOne")
  matchesAsP2     BattleMatch[]           @relation("PlayerTwo")

  @@map("students")
}

// 2. 教學週次 (週次編號、單元名稱、是否已結算)
model AcademicWeek {
  id              String                   @id @default(cuid())
  weekNumber      Int                      @unique
  title           String                   // 例如 "第 1 週：分數的除法與四則運算"
  isSettled       Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  examScores      ExamScore[]
  homeworkRecords HomeworkRecord[]
  quizQuestions   WeeklyQuizQuestion[]
  questLogs       StudentWeeklyQuestLog[]
  weeklyLoadouts  WeeklyStudentLoadout[]
  matches         BattleMatch[]

  @@map("academic_weeks")
}

// 3. 作業繳交紀錄 (已完成 / 缺交 / 待訂正)
model HomeworkRecord {
  id              String       @id @default(cuid())
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekId          String
  academicWeek    AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  status          String       // 'COMPLETED' (已完成) | 'MISSING' (缺交) | 'PARTIAL' (待訂正)
  missingScope    String?      // 缺交或待訂正範圍 (例如 "數習 P.32-35")
  updatedAt       DateTime     @updatedAt

  @@unique([studentId, weekId])
  @@map("homework_records")
}

// 4. 週考三科成績 (國英數成績、平均、過去三週滾動平均)
model ExamScore {
  id              String       @id @default(cuid())
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekId          String
  academicWeek    AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  chineseScore    Float        @default(0)
  englishScore    Float        @default(0)
  mathScore       Float        @default(0)
  averageScore    Float        @default(0) // (國+英+數) / 3
  previousAverage Float        @default(0) // 過去三週滾動平均，判定是否進步
  updatedAt       DateTime     @updatedAt

  @@unique([studentId, weekId])
  @@map("exam_scores")
}

// 5. 每週共用題庫（四選一，國/英/數各 3 題 + 單字 10 題）
model WeeklyQuizQuestion {
  id            String       @id @default(cuid())
  weekId        String
  academicWeek  AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  category      String       // 'CHINESE' | 'ENGLISH' | 'MATH' | 'VOCAB'
  questionText  String
  options       String       // JSON 字串 ["選項A", "選項B", "選項C", "選項D"]
  correctAnswer String       // 正確選項內容或 "A"/"B"/"C"/"D"
  explanation   String?      // 簡短解析
  createdAt     DateTime     @default(now())

  @@map("weekly_quiz_questions")
}

// 6. 學生每週自主修練完成狀態 (任一完成即解鎖勤勉晶片)
model StudentWeeklyQuestLog {
  id               String       @id @default(cuid())
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekId           String
  academicWeek     AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  completedMath    Boolean      @default(false)
  completedChinese Boolean      @default(false)
  completedEnglish Boolean      @default(false)
  completedVocab   Boolean      @default(false)
  hasUnlockedChip  Boolean      @default(false) // 任一完成即為 true，解鎖勤勉晶片
  updatedAt        DateTime     @updatedAt

  @@unique([studentId, weekId])
  @@map("student_weekly_quest_logs")
}

// 7. 學生每週自選裝備晶片 (1/1)
model WeeklyStudentLoadout {
  id           String       @id @default(cuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  weekId       String
  academicWeek AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  equippedChip String       // MATH_VOID | CHINESE_INK | ENGLISH_STORM | ADVERSITY_SHATTER | GUARDIAN_BASTION | SELF_TRANSCENDENCE
  updatedAt    DateTime     @updatedAt

  @@unique([studentId, weekId])
  @@map("weekly_student_loadouts")
}

// 8. 30 秒對戰推演日誌
model BattleMatch {
  id           String       @id @default(cuid())
  weekId       String
  academicWeek AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player1Id    String
  player1      Student      @relation("PlayerOne", fields: [player1Id], references: [id], onDelete: Cascade)
  player2Id    String
  player2      Student      @relation("PlayerTwo", fields: [player2Id], references: [id], onDelete: Cascade)
  winnerId     String?
  isDraw       Boolean      @default(false)
  battleLog    String       // 記錄 3 回合動作序列、傷害跳字、晶片特效與勝負因果文本 JSON
  createdAt    DateTime     @default(now())

  @@unique([weekId, player1Id])
  @@map("battle_matches")
}
