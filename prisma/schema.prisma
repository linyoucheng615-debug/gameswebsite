// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 學生資料表 (學號唯一約束、姓名、家長電話、外觀ID、勝負平統計)
model Student {
  id            String   @id @default(cuid())
  studentNumber String   @unique // 學號 (例：S101)
  name          String   // 學生真實姓名
  parentPhone   String?  // 家長聯絡電話
  avatarId      String   @default("pixel-knight") // 2D 像素外觀 ID (pixel-knight, pixel-mage, pixel-ninja, pixel-archer...)
  skinGender    String   @default("boy") // "boy" | "girl"
  skinClass     String   @default("warrior") // "warrior" | "mage" | "ranger" | "assassin"
  skinColor     String   @default("blue") // "blue" | "red" | "green" | "purple" | "gold"
  wins          Int      @default(0) // 勝場數
  losses        Int      @default(0) // 敗場數
  draws         Int      @default(0) // 平手數
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homeworkRecords HomeworkRecord[]
  examScores      ExamScore[]
  matchesAsA      BattleMatch[]    @relation("PlayerAMatches")
  matchesAsB      BattleMatch[]    @relation("PlayerBMatches")
  wonMatches      BattleMatch[]    @relation("WonMatches")
  expCoin         StudentExpCoin?
  strategies      StudentStrategy[]

  @@map("students")
}

// 2. 週次資料表 (週次編號、單元名稱、補交期限文字、是否已結算)
model AcademicWeek {
  id          String   @id @default(cuid())
  weekNumber  Int      @unique // 週次編號 (例：1, 2, 3...)
  title       String   // 當週單元名稱 (例：分數的除法與四則運算)
  deadline    String   // 補交期限文字 (例：本週五 18:00 前)
  isSettled   Boolean  @default(false) // 是否已完成對戰結算
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  homeworkRecords HomeworkRecord[]
  examScores      ExamScore[]
  battleMatches   BattleMatch[]
  strategies      StudentStrategy[]

  @@map("academic_weeks")
}

// 3. 作業登記資料表 (週次、學生、狀態、缺交範圍、Buff標記)
model HomeworkRecord {
  id           String       @id @default(cuid())
  weekId       String
  studentId    String
  status       String       @default("completed") // "completed" | "missing" | "partial"
  missingScope String?      // 缺交範圍文字 (例：數習 P.32-P.35)
  hasBuff      Boolean      @default(true) // 是否獲得戰力護盾 (+5 分)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  week         AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weekId, studentId])
  @@map("homework_records")
}

// 4. 週考成績資料表 (週次、學生、原始成績、最終有效戰力)
model ExamScore {
  id             String       @id @default(cuid())
  weekId         String
  studentId      String
  rawScore       Float        // 考試原始卷面成績
  effectivePower Float        // 最終有效戰力 = rawScore + (hasBuff ? 5 : 0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  week           AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([weekId, studentId])
  @@map("exam_scores")
}

// 5. 對戰配對資料表 (週次、玩家A、玩家B/替身機器人、勝負平、戰鬥腳本JSON)
model BattleMatch {
  id         String       @id @default(cuid())
  weekId     String
  playerAId  String
  playerBId  String?      // 可為 null (若為替身機器人)
  botName    String?      // 替身機器人名稱 (例：分段守門員 Alpha)
  botPower   Float?       // 替身機器人有效戰力
  botAvatar  String?      // 替身機器人外觀 ID
  winnerId   String?      // 獲勝學生 ID (平手或機器人獲勝則可特殊記錄)
  isDraw     Boolean      @default(false) // 是否平手
  battleLog  String       // 戰鬥腳本 JSON 字串 (包含 Buff 觸發、衝撞位移、扣血數值、結算結果)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  week       AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  playerA    Student      @relation("PlayerAMatches", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB    Student?     @relation("PlayerBMatches", fields: [playerBId], references: [id], onDelete: SetNull)
  winner     Student?     @relation("WonMatches", fields: [winnerId], references: [id], onDelete: SetNull)

  @@map("battle_matches")
}

// 6. 單字題庫資料表 (英文、中文)
model VocabularyWord {
  id        String   @id @default(cuid())
  english   String   @unique
  chinese   String
  createdAt DateTime @default(now())

  @@map("vocabulary_words")
}

// 7. 學生經驗值與金幣資料表 (等級、當前經驗、金幣、每日已測驗次數、上次測驗日期)
model StudentExpCoin {
  id             String   @id @default(cuid())
  studentId      String   @unique
  level          Int      @default(1)
  currentExp     Int      @default(0)
  coins          Int      @default(0)
  dailyQuizCount Int      @default(0)
  lastQuizDate   String?  // 格式 YYYY-MM-DD 用於跨日重置每日3次上限
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_exp_coins")
}

// 8. 學生每週出牌戰術表 (學生ID、週次ID、5回合出招卡片、是否鎖定)
model StudentStrategy {
  id        String       @id @default(cuid())
  studentId String
  weekId    String
  card1     String       @default("charge")   // charge | attack | defend | break | ultimate
  card2     String       @default("attack")
  card3     String       @default("defend")
  card4     String       @default("charge")
  card5     String       @default("ultimate")
  isLocked  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  student   Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  week      AcademicWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekId])
  @@map("student_strategies")
}

